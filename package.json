        },
        {
          "type": "png",
          "name": "IMAGE_BT_CONNECTED",
          "file": "images/etank.png"
        },
        {
          "type": "png",
          "name": "IMAGE_BT_DISCONNECTED",
          "file": "images/etank_empty.png"
        }
      ]
    }
